{
  "version": 2,
  "outputDirectory": ".",
  "functions": {
    "api/products.js": { "maxDuration": 30 },
    "api/img.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
